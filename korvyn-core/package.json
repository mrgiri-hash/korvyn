{
  "name": "@korvyn/core",
  "version": "0.0.1",
  "private": true,
  "description": "Korvyn canonical accounting model and integration boundary",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./domain": "./dist/domain/index.js",
    "./integration": "./dist/integration/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "build": "tsc",
    "test": "npm run build && node --test \"test/**/*.test.ts\"",
    "check": "npm run typecheck && npm run typecheck:test && npm test && python tools/check_boundary.py"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=20"
  }
}
