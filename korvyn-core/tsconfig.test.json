/*
 * Typechecks the test suite. Separate from the main tsconfig because the tests
 * import from `dist/` (the emitted artifact plus its .d.ts) rather than from
 * `src/`, and because they must not be compiled into the published output.
 *
 * `npm run typecheck` covers src; this covers test. Both run under `npm run check`.
 */
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "allowImportingTsExtensions": true
  },
  "include": ["test/**/*.ts"],
  "exclude": ["node_modules"]
}
