# Claude Code local machine settings (not shared).
# .claude/launch.json IS shared — it is how the preview server starts.
.claude/settings.local.json

# Cursor is no longer used (2026-09-02) and its shared rules mirror was retired, so the whole
# directory is ignored — local editor state cannot land in the repo by accident.
.cursor/

# Superseded snapshots. CLAUDE.md has always described this directory as git-ignored;
# only the one file inside it was actually matched, by name, so anything else dropped
# here would have been committed by accident.
archive/
.locusos_v12_backup_pre_theme.html

# Dependencies and build output. packages/*/.gitignore already cover their own trees;
# these are the belt-and-braces copies so a stray install at the root cannot land in a
# commit. package-lock.json files ARE committed.
node_modules/
dist/
*.tsbuildinfo
__pycache__/
*.pyc

# Secrets. packages/agent/.env holds a real Claude API key; .env.example is the template.
.env
.env.local
*.local

# macOS / Windows / iCloud noise
.DS_Store
Thumbs.db
desktop.ini
*.icloud
