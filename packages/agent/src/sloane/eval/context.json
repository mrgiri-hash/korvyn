     "expect": {
      "metric": "MODIFY_VS_NEW",
      "sameAs": 0,
      "columnsInclude": [
       "entity"
      ],
      "clarify": false
     }
    },
    {
     "say": "just South Valley",
     "expect": {
      "metric": "MODIFY_VS_NEW",
      "sameAs": 0,
      "filter": {
       "dimension": "project",
       "value": "SV-PH2"
      },
      "statement": "BS",
      "clarify": false
     }
    }
