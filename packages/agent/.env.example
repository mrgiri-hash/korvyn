# Copy this file to `.env` (packages/agent/.env) and fill it in. `.env` is git-ignored.
# The Anthropic key is read ONLY from packages/agent/.env — a key in the shell environment is ignored.
# It is never logged, never returned to the browser, and never committed.
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Sloane models. No model id is hard-coded on the Sloane path; set both.
#   DEFAULT  — normal conversational / general reasoning (front door, interpretation, narration)
#   ADVANCED — reserved for advanced / escalated reasoning (multi-step planning, reviews, agent runs)
ANTHROPIC_DEFAULT_MODEL=claude-sonnet-5
ANTHROPIC_ADVANCED_MODEL=claude-opus-5

# Optional
# SLOANE_LLM_PROVIDER=anthropic          # or mock (deterministic engine, used by tests)
# SLOANE_LLM_NARRATE_MODEL=claude-haiku-4-5   # override the narration model (defaults to ANTHROPIC_DEFAULT_MODEL)
# SLOANE_RUNTIME_V2=1                    # the V2 conversational core, beside the v1 orchestrator (default off)
