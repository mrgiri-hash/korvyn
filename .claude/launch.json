{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "main",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-c",
        "import os,http.server,socketserver;socketserver.TCPServer.allow_reuse_address=True;socketserver.TCPServer(('',int(os.environ.get('PORT') or 8780)),http.server.SimpleHTTPRequestHandler).serve_forever()"
      ],
      "port": 8780,
      "autoPort": true
    },
    {
      "name": "review",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-c",
        "import os,functools,http.server,socketserver;socketserver.TCPServer.allow_reuse_address=True;socketserver.TCPServer(('',int(os.environ.get('PORT') or 8779)),functools.partial(http.server.SimpleHTTPRequestHandler,directory='apps/review')).serve_forever()"
      ],
      "port": 8779,
      "autoPort": true
    }
  ]
}
